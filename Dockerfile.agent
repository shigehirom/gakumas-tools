FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# システム依存パッケージのインストール
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Python 依存関係のインストール
COPY gakumas-agent-bot/requirements.txt ./gakumas-agent-bot/requirements.txt
RUN pip install --no-cache-dir -r gakumas-agent-bot/requirements.txt

# マスタデータ、画像アセット、ナレッジ、Bot コードのコピー
COPY packages/gakumas-data/csv ./packages/gakumas-data/csv
COPY packages/gakumas-images/images ./packages/gakumas-images/images
COPY gakumas-support_cards ./gakumas-support_cards
COPY agent-instructions ./agent-instructions
COPY shared/gakumas-dev/knowledge ./shared/gakumas-dev/knowledge
COPY gakumas-agent-bot ./gakumas-agent-bot
COPY .env.local* ./.env.local
COPY .env.local* ./gakumas-agent-bot/.env

WORKDIR /app/gakumas-agent-bot

CMD ["python3", "gakumas_agent_bot.py"]
