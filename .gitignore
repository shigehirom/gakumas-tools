.DS_Store

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# dependencies
/node_modules
/.pnp
.pnp.*

# yarn berry cache (always ignore to prevent large commits)
# documentation here: https://yarnpkg.com/features/zero-installs
!.yarn/cache
#.pnp.*

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/

# production
/build
/dist

# misc
*.pem
*.tsbuildinfo
next-env.d.ts

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# db dumps
/dump

# Custom
.env
.env.local
.env*.local
screenshots/

# Google API / GDrive Credentials
credentials.json
client_secret*.json
gakumas-tools-*.json
tokens.json
*.apps.googleusercontent.com.json

# Other Local Secret/Data Files
appliance_id.json
